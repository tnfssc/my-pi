{
  "lastChangelogVersion": "0.79.6",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true
  },
  "followUpMode": "one-at-a-time",
  "steeringMode": "all",
  "transport": "auto",
  "theme": "dark",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true
  },
  "hideThinkingBlock": true,
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.3-codex-spark",
    "github-copilot/claude-sonnet-4.6"
  ],
  "quietStartup": true,
  "httpIdleTimeoutMs": 30000,
  "packages": [
    "npm:pi-hermes-memory"
  ],
  "shellPath": "/bin/zsh",
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      },
      "planner": {
        "disabled": true
      },
      "researcher": {
        "disabled": true
      },
      "reviewer": {
        "disabled": true
      },
      "scout": {
        "disabled": true
      },
      "worker": {
        "disabled": true
      }
    },
    "disableBuiltins": true
  },
  "autocompleteMaxVisible": 10,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "extensions": [
    "profile-resources/codex/extensions/cmux-terminals",
    "profile-resources/codex/extensions/cmux-subagents",
    "profile-resources/codex/extensions/codex-lite",
    "extensions/cmux-attention"
  ]
}
